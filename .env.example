# Server-only settings. Copy to the repository root .env.local.
# Never prefix the OpenRouter key with VITE_.
OPENROUTER_API_KEY=
# Set an exact model ID from your OpenRouter model page.
OPENROUTER_MODEL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Google Calendar: server-only. Use Preview-specific URLs for branch testing.
APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# 32 random bytes encoded as base64; keep stable after credentials are encrypted.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# New Supabase secret key (sb_secret_...). Legacy service-role key is a fallback.
SUPABASE_SECRET_KEY=
